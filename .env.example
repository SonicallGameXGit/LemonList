# Drizzle
DATABASE_URL=local.db

ORIGIN=""

# Uploaded media (avatars, level previews), defaults to "media" in the working directory
MEDIA_DIR=media

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Email (nodemailer). Leave SMTP_URL empty to print emails to the console in development
SMTP_URL=""
MAIL_FROM="LemonList <noreply@example.com>"
